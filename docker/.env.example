# Copy: cp docker/.env.example docker/.env
# Compose reads .env from the directory holding compose.yml, so this file has to
# sit here rather than at the repo root.
#
# GOLD_DRAFT_BASE_URL / GROUNDEDNESS_BASE_URL point at two local vLLM servers
# (Section 5.5), each hosting exactly one model. Unlike the old single Ollama
# server, a vLLM server does not host a catalogue -- these are two different
# addresses on purpose, so the drafting and reviewing roles cannot silently
# collapse onto the same server.
GOLD_DRAFT_BASE_URL=http://furkan.ozturk_vllm:8003
GROUNDEDNESS_BASE_URL=http://furkan.ozturk_vllm:8001

# Credentials for the loghub service's Postgres (+pgvector) server, which
# datasetgen queries over datasetgen-net (not exposed to the host).
POSTGRES_DB=loghub
POSTGRES_USER=loghub
POSTGRES_PASSWORD=change-me
