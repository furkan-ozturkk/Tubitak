{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logrouter-datasetgen.local/schema/question_schema.json",
  "title": "LogRouter Evaluation Question",
  "description": "The single-source-of-truth schema defined in Section 6.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "question", "routing_path", "answer_type", "task", "difficulty",
    "phrasing_family", "split", "review_status", "reviewers", "expected_answer",
    "gold_provenance", "evidence", "validation"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9_]+$" },
    "question": { "type": "string", "minLength": 1 },
    "routing_path": { "type": "string", "enum": ["sql", "keyword", "semantic"] },
    "answer_type": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
    "phrasing_family": { "type": "string", "minLength": 1 },
    "split": { "type": "string", "enum": ["dev", "test"] },
    "review_status": { "type": "string", "enum": ["verified", "in_review", "rejected"] },
    "reviewers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "expected_answer": { "type": "string", "minLength": 1 },
    "gold_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "created_by", "created_at", "corpus_sha256"],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "deterministic_aggregation",
            "human",
            "independent_model_then_human",
            "model_written_deterministic_sql"
          ]
        },
        "created_by": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "corpus_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "family", "digest", "prompt_sha256"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "family": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "minLength": 1 },
            "prompt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      },
      "allOf": [
        {
          "comment": "The model block is required ONLY for model-assisted gold (independent_model_then_human).",
          "if": { "properties": { "method": { "const": "independent_model_then_human" } } },
          "then": { "required": ["model"] }
        },
        {
          "comment": "Deterministic gold must not include a model block (Section 6: 'only for model-assisted gold').",
          "if": { "properties": { "method": { "const": "deterministic_aggregation" } } },
          "then": { "not": { "required": ["model"] } }
        },
        {
          "comment": "model_written_deterministic_sql (Section 7.1: a model invents the question and the SQL, but the answer is still executed and re-derivable) must name the inventing model, same as model-assisted gold.",
          "if": { "properties": { "method": { "const": "model_written_deterministic_sql" } } },
          "then": { "required": ["model"] }
        }
      ]
    },
    "numeric_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "query"],
        "properties": {
          "value": { "type": "number" },
          "query": {
            "type": "object",
            "additionalProperties": false,
            "required": ["operator"],
            "properties": {
              "operator": {
                "type": "string",
                "enum": ["count_literal", "count_regex", "raw_sql"]
              },
              "literal": { "type": "string" },
              "pattern": { "type": "string" },
              "case_sensitive": { "type": "boolean" },
              "sql": { "type": "string", "minLength": 1 },
              "evidence_sql": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              {
                "if": { "properties": { "operator": { "const": "count_literal" } } },
                "then": { "required": ["literal", "case_sensitive"] }
              },
              {
                "if": { "properties": { "operator": { "const": "count_regex" } } },
                "then": { "required": ["pattern", "case_sensitive"] }
              },
              {
                "comment": "raw_sql (Section 7.1 model-invented easy questions): the stored statement is what validate.py re-executes against Postgres to reproduce the value -- evidence_sql is present only for a scalar-mode question, whose answer has no 'matching lines' of its own.",
                "if": { "properties": { "operator": { "const": "raw_sql" } } },
                "then": { "required": ["sql"] }
              }
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refs"],
      "properties": {
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "line_number", "line_hash", "group_id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "line_number": { "type": "integer", "minimum": 1 },
              "line_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "group_id": { "type": "string", "minLength": 1 }
            }
          }
        },
        "query_sql": {
          "type": "string",
          "minLength": 1,
          "comment": "Section 7.1: the SQL statement that computes expected_answer, shown directly under evidence -- Qwen2.5-Coder-14B-Instruct-AWQ's own text for a model-invented (raw_sql) question, or the equivalent statement Postgres runs for a curated count_literal/count_regex one (src.generators.easy_tier.query_display_sql). Required exactly where numeric_claims is."
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "model"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension", "verdict"],
            "properties": {
              "dimension": { "type": "string", "minLength": 1 },
              "verdict": { "type": "string", "enum": ["yes", "no", "partial"] },
              "detail": { "type": "string" }
            }
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "family", "digest", "prompt_sha256"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "family": { "type": "string", "minLength": 1 },
            "digest": { "type": "string", "minLength": 1 },
            "prompt_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      }
    },
    "structured_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_type", "entity", "observed_events", "outcome"],
      "properties": {
        "event_type": { "type": "string", "minLength": 1 },
        "entity": { "type": "string", "minLength": 1 },
        "observed_events": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "comment": "structured_summary is REQUIRED for medium-tier records (Section 7.2 two-stage draft) and forbidden elsewhere, since only the medium generator produces the intermediate extraction.",
      "if": { "properties": { "difficulty": { "const": "medium" } } },
      "then": { "required": ["structured_summary"] },
      "else": { "not": { "required": ["structured_summary"] } }
    },
    {
      "comment": "numeric_claims is REQUIRED for numeric gold (count/presence/scalar) (Section 6; scalar added by Section 7.1 model-invented aggregate questions).",
      "if": { "properties": { "answer_type": { "enum": ["count", "presence", "scalar"] } } },
      "then": { "required": ["numeric_claims"] }
    },
    {
      "comment": "evidence.query_sql is REQUIRED exactly where numeric_claims is (Section 7.1): the query that computed the answer must be visible directly under evidence, not only inside numeric_claims.query. Forbidden for line_lookup/explanation/synthesis answers, which have no such query.",
      "if": { "properties": { "answer_type": { "enum": ["count", "presence", "scalar"] } } },
      "then": { "properties": { "evidence": { "required": ["query_sql"] } } },
      "else": { "properties": { "evidence": { "not": { "required": ["query_sql"] } } } }
    },
    {
      "comment": "routing_path=sql is only used for numeric/statistic answers.",
      "if": { "properties": { "routing_path": { "const": "sql" } } },
      "then": { "properties": { "answer_type": { "enum": ["count", "presence", "scalar"] } } }
    },
    {
      "comment": "routing_path=keyword is only used for raw line display (line_lookup).",
      "if": { "properties": { "routing_path": { "const": "keyword" } } },
      "then": { "properties": { "answer_type": { "const": "line_lookup" } } }
    }
  ]
}
