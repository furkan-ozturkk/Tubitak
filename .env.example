# Copy: cp .env.example .env
# OLLAMA_BASE_URL is the remote (user-provided, pre-existing) Ollama server.
# Its setup/operation is not this project's responsibility (Section 5.5).
OLLAMA_BASE_URL=http://10.15.33.66:11435

# Credentials for the loghub service's Postgres (+pgvector) server, which
# datasetgen queries over datasetgen-net (not exposed to the host).
POSTGRES_DB=loghub
POSTGRES_USER=loghub
POSTGRES_PASSWORD=change-me
